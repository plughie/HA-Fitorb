// Release-safe default. Override in LocalDefaults.xcconfig only for a trusted
// local Home Assistant server.
FITORB_ALLOW_HTTP = NO

// To add local build settings, copy LocalDefaults.xcconfig.example to
// LocalDefaults.xcconfig in this directory, then edit the copy. The copied
// LocalDefaults.xcconfig file is ignored by Git.
#include? "LocalDefaults.xcconfig"
